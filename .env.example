TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Shared production PostgreSQL database. Never commit a real URL or password.
DATABASE_URL=postgresql://listner:replace-with-password@db.example.com:5432/listner?sslmode=require
# Persistent Telethon user-account session path; authenticate it once locally.
TELEGRAM_SESSION=/data/telethon.session
# Optional: base64-like Telethon StringSession; when set, this takes precedence over TELEGRAM_SESSION.
TELEGRAM_SESSION_STRING=
BOT_TOKEN=
BOT_CHAT_ID=
CONTROL_SECRET=replace-with-a-long-random-secret
POLL_SECONDS=2
LEASE_SECONDS=10
